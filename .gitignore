# Never commit actual credentials or cached tokens
.aws/credentials
.aws/sso/
.aws/cli/
.env

# .aws/config is generated from ansible/files/aws-config.ini.j2 (rendered by
# ansible/deploy.yml's pre_tasks, and before that by scripts/lib/common.sh),
# so use_fips_endpoint always tracks the `fips:` switch -- do not track it.
.aws/config

*.log
state/
logs/
kubeconfig*

# project-local python for ansible modules (recreate with part1-setup.sh)
.venv/
state/skopeo-auth.json

# kubectl preflight writes a support bundle into its cwd; the role runs from state/ but belt and braces
preflightbundle-*.tar.gz

# harness worktrees are throwaway; plan state under .claude/plans is tracked on purpose
.claude/worktrees/

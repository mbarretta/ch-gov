# ============================================================================
# AWS CLI config -- ClickHouse Private on EKS (aws.auth_mode: sso)
# GENERATED by ansible/deploy.yml's pre_tasks (tags: [always]) and, before
# Ansible ever runs, by scripts/lib/common.sh's render_aws_config -- this file
# is re-rendered on EVERY run, so hand-editing it (or this tracked template,
# ansible/files/aws-config.ini.j2) never survives the next one. Set your real
# account ID and SSO portal URL in state/deploy-vars.yml instead (see
# docs/part-1-prerequisites.md, "Persisting your account IDs") -- this template must never carry
# a real value, since it is committed to git.
#
# With aws.auth_mode: profile this file is not rendered at all; the kit uses
# your own AWS_CONFIG_FILE (or the AWS CLI default) and the named profiles
# aws.target_profile and aws.source_ecr_profile must exist there.
#
# Profile NAMES come from group_vars/all.yml's aws: block:
#   aws.target_profile     -> your account (infra, EKS, S3, your ECR)
#   aws.source_ecr_profile -> assumed role for ClickHouse's source ECR
#
# use_fips_endpoint routes this profile's AWS API calls (STS, IAM, EKS, S3,
# CloudFormation, ...) through FIPS 140-3 validated endpoints when fips: true.
# It does NOT inherit from source_profile -- AWS SDKs read it per-profile --
# so both profiles below set it explicitly, matching the single `fips` switch
# in ansible/group_vars/all.yml.
# ============================================================================

# ---------- SSO login session (shared by profiles below) ----------
[sso-session {{ aws.sso_session_name }}]
sso_start_url = {{ aws.sso_start_url }}
sso_region = {{ aws.sso_region }}
sso_registration_scopes = sso:account:access

# ---------- target profile: your deployment account ----------
[profile {{ aws.target_profile }}]
sso_session = {{ aws.sso_session_name }}
sso_account_id = {{ aws.target_account_id }}
sso_role_name = {{ aws.sso_role_name }}
region = {{ aws.target_region }}
output = json
use_fips_endpoint = {{ 'true' if fips else 'false' }}

# ---------- ECR pull profile: cross-account pull of ClickHouse source images ----------
# Assumes aws.ecr_pull_role_name in your own target account; the images
# themselves live in the source ECR account (aws.source_ecr_account_id).
[profile {{ aws.source_ecr_profile }}]
source_profile = {{ aws.target_profile }}
role_arn = arn:{{ aws.partition }}:iam::{{ aws.target_account_id }}:role/{{ aws.ecr_pull_role_name }}
role_session_name = {{ aws.ecr_pull_session_name }}
region = {{ aws.target_region }}
output = json
use_fips_endpoint = {{ 'true' if fips else 'false' }}

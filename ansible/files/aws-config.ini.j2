# ============================================================================
# AWS CLI config — ClickHouse Private on EKS
# GENERATED by ansible/deploy.yml's pre_tasks (tags: [always]) and, before
# Ansible ever runs, by scripts/lib/common.sh's render_aws_config -- do not
# hand-edit; edit this template (ansible/files/aws-config.ini.j2) instead.
#
# Profile NAMES matter: deploy-config.yaml refers to them as
#   target_profile: "sa"          -> your account (infra, EKS, S3, your ECR)
#   source_ecr_profile: "private-us" -> assumed role for ClickHouse's source ECR
# Renaming these means editing deploy-config.yaml to match.
#
# use_fips_endpoint routes this profile's AWS API calls (STS, IAM, EKS, S3,
# CloudFormation, ...) through FIPS 140-3 validated endpoints when fips: true.
# It does NOT inherit from source_profile -- AWS SDKs read it per-profile --
# so both [profile sa] and [profile private-us] set it explicitly, matching
# the single `fips` switch in ansible/group_vars/all.yml.
# ============================================================================

# ---------- SSO login session (shared by profiles below) ----------
[sso-session clickhouse]
sso_start_url = https://<YOUR_SSO_PORTAL_ID>.awsapps.com/start
sso_region = us-east-1
sso_registration_scopes = sso:account:access

# ---------- "sa": your deployment account ----------
[profile sa]
sso_session = clickhouse
sso_account_id = <YOUR_ACCOUNT_ID>
sso_role_name = SolutionArchitect
region = us-east-1
output = json
use_fips_endpoint = {{ 'true' if fips else 'false' }}

# ---------- "private-us": cross-account pull of ClickHouse source images ----------
# NOTE: the training guide prints role_arn with account 925472944448, but the
# role that actually exists and works for this login is in <YOUR_ACCOUNT_ID> --
# which matches the guide's own "Expected output" block. Using the working one.
# Images themselves live in account <SOURCE_ECR_ACCOUNT_ID> (source ECR).
[profile private-us]
source_profile = sa
role_arn = arn:aws:iam::<YOUR_ACCOUNT_ID>:role/ClickHouseAirgapECRPullRole
role_session_name = you@example.com
region = us-east-1
output = json
use_fips_endpoint = {{ 'true' if fips else 'false' }}


AWSTemplateFormatVersion: '2010-09-09'
Description: >-
  ClickHouse Private on EKS -- Grafana IRSA role. One role that Grafana's own
  Kubernetes service account assumes directly, with no static credentials
  anywhere, to read the mirrored grafana-clickhouse-datasource plugin zip
  out of its S3 bucket.

# NOTE: this file is a Jinja template, not plain CloudFormation, for the same
# reason as storage_iam/templates/irsa-roles.yaml.j2 and
# langfuse_storage/templates/langfuse-irsa.yaml.j2. An IRSA condition key
# embeds the cluster's OIDC issuer in the key NAME:
#
#     "oidc.eks.us-east-1.amazonaws.com/id/ABC123:sub": "system:serviceaccount:..."
#
# CloudFormation cannot build that, because !Sub may not be used as a map key
# ("map keys must be strings; received a map instead"). Rendering the issuer in
# with Ansible first makes the key a literal, so the stack stays in
# CloudFormation like every other piece of infrastructure here.

Parameters:
  BucketName:
    Type: String

Resources:
  # =========================================================================
  # grafana -> S3 (plugin mirror, read-only)
  # =========================================================================
  # This is IRSA. The trust policy says: any pod presenting a token signed by
  # THIS cluster's OIDC issuer, whose subject is exactly this one service
  # account, may assume this role. Nothing else can -- not another namespace,
  # not another service account, not another cluster.
  #
  # Both conditions matter:
  #   :aud must be sts.amazonaws.com, so a token minted for a different
  #        audience cannot be replayed against STS here.
  #   :sub pins the exact system:serviceaccount:<ns>:<name>. The name is the
  #        Helm release name: Step 18 passes it as the chart's
  #        fullnameOverride, which the chart names its ServiceAccount after.
  #        Omit :sub and any pod in the cluster could assume this role and
  #        read the plugin bucket.
  GrafanaS3Role:
    Type: AWS::IAM::Role
    Properties:
      # No RoleName, for the same reason as every other role in this project:
      # a collision in a shared account surfaces only as "Validation failed
      # with 1 error(s)". Nothing depends on the name, because the service
      # account is annotated from this stack's output in Step 18.
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal:
              Federated: "{{ _gf_oidc_provider_arn }}"
            Action: sts:AssumeRoleWithWebIdentity
            Condition:
              StringEquals:
                "{{ _gf_oidc_issuer_host }}:aud": "sts.amazonaws.com"
                "{{ _gf_oidc_issuer_host }}:sub": "system:serviceaccount:{{ grafana.namespace }}:{{ grafana.release }}"
      Policies:
        - PolicyName: grafana-plugin-read
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              # Deliberately the narrowest policy in this project: the Step 18
              # initContainer always names the exact key
              # (plugins/grafana-clickhouse-datasource-<version>.zip), so it
              # never needs ListBucket, and it has no business writing to or
              # deleting from a bucket this role alone manages. No bucket-ARN
              # statement either -- that would only be needed for ListBucket,
              # which is intentionally absent.
              - Effect: Allow
                Action: 's3:GetObject'
                Resource: !Sub 'arn:aws:s3:::${BucketName}/plugins/*'
      Tags:
        - {Key: Project, Value: clickhouse-private}

Outputs:
  GrafanaS3RoleArn:
    Description: The Grafana chart's ServiceAccount is annotated with this in Step 18.
    Value: !GetAtt GrafanaS3Role.Arn

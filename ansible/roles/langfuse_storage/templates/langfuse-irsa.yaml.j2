AWSTemplateFormatVersion: '2010-09-09'
Description: >-
  ClickHouse Private on EKS -- Langfuse IRSA role. One role that the Langfuse
  Kubernetes service account assumes directly, with no static credentials
  anywhere, to reach the bucket holding its events, batch exports and media.

# NOTE: this file is a Jinja template, not plain CloudFormation, for the same
# reason as storage_iam/templates/irsa-roles.yaml.j2. An IRSA condition key
# embeds the cluster's OIDC issuer in the key NAME:
#
#     "oidc.eks.us-east-1.amazonaws.com/id/ABC123:sub": "system:serviceaccount:..."
#
# CloudFormation cannot build that, because !Sub may not be used as a map key
# ("map keys must be strings; received a map instead"). Rendering the issuer in
# with Ansible first makes the key a literal, so the stack stays in
# CloudFormation like every other piece of infrastructure here.

Parameters:
  BucketName:
    Type: String

Resources:
  # =========================================================================
  # langfuse web + worker -> S3
  # =========================================================================
  # This is IRSA. The trust policy says: any pod presenting a token signed by
  # THIS cluster's OIDC issuer, whose subject is exactly this one service
  # account, may assume this role. Nothing else can -- not another namespace,
  # not another service account, not another cluster.
  #
  # Both conditions matter:
  #   :aud must be sts.amazonaws.com, so a token minted for a different
  #        audience cannot be replayed against STS here.
  #   :sub pins the exact system:serviceaccount:<ns>:<name>. The name is the
  #        Helm release name: Step 15 passes it as the chart's
  #        fullnameOverride, which the chart names its ServiceAccount after.
  #        Omit :sub and any pod in the cluster could assume this role and
  #        read the bucket.
  LangfuseS3Role:
    Type: AWS::IAM::Role
    Properties:
      # No RoleName, for the same reason as every other role in this project:
      # a collision in a shared account surfaces only as "Validation failed
      # with 1 error(s)". Nothing depends on the name, because the service
      # account is annotated from this stack's output in Step 15.
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal:
              Federated: "{{ _lf_oidc_provider_arn }}"
            Action: sts:AssumeRoleWithWebIdentity
            Condition:
              StringEquals:
                "{{ _lf_oidc_issuer_host }}:aud": "sts.amazonaws.com"
                "{{ _lf_oidc_issuer_host }}:sub": "system:serviceaccount:{{ langfuse.namespace }}:{{ langfuse.release }}"
      Policies:
        - PolicyName: langfuse-s3-access
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              # Scoped to this bucket only, and to the four verbs Langfuse's
              # blob-storage documentation requires: write and read objects,
              # list the bucket, and delete (media removal, export retention).
              # Unlike the ClickHouse role this is narrow in verbs too --
              # Langfuse's S3 client is a single well-documented code path,
              # not a database engine with a moving set of operations.
              - Effect: Allow
                Action:
                  - s3:PutObject
                  - s3:GetObject
                  - s3:ListBucket
                  - s3:DeleteObject
                Resource:
                  - !Sub 'arn:aws:s3:::${BucketName}'
                  - !Sub 'arn:aws:s3:::${BucketName}/*'
{% if fips %}
              # FIPS hardening Phase 2: the bucket's default encryption below
              # becomes aws:kms (see langfuse_storage/tasks/main.yml), backed
              # by LangfuseBucketKmsKey. This is the ONLY statement anywhere
              # that grants a real principal use of that key -- see the key's
              # own KeyPolicy comment for why access is delegated here, in
              # IAM, rather than named directly in the key policy.
              - Effect: Allow
                Action:
                  - kms:Decrypt
                  - kms:GenerateDataKey*
                  - kms:DescribeKey
                Resource: !GetAtt LangfuseBucketKmsKey.Arn
{% endif %}
      Tags:
        - {Key: Project, Value: clickhouse-private}
{% if fips %}
  # =========================================================================
  # Customer-managed KMS key (FIPS 140-3 hardening, Phase 2)
  # =========================================================================
  # Account-root admin only, same reasoning as storage_iam's KMS keys: a
  # KeyPolicy statement naming LangfuseS3Role.Arn while that role's own
  # policy names the key's Arn back is a circular resource dependency, which
  # CloudFormation refuses to create. Real access is delegated entirely to
  # LangfuseS3Role's own IAM policy above, a one-directional dependency.
  LangfuseBucketKmsKey:
    Type: AWS::KMS::Key
    # Retained on purpose: the Langfuse bucket outlives this stack (see "the
    # bucket" comment in langfuse_storage/tasks/main.yml), but the key that
    # protects its ciphertext lives here, inside the disposable IRSA stack.
    # Without Retain, tearing down --tags lf-storage schedules this key's
    # deletion and strands every object the bucket still holds.
    DeletionPolicy: Retain
    UpdateReplacePolicy: Retain
    Properties:
      Description: >-
        SSE-KMS key for the Langfuse bucket ({{ langfuse.bucket_name }}).
        Retained across teardown/recreation of the
        {{ infrastructure.environment_name }}-langfuse-irsa stack -- the
        bucket the key protects is never deleted.
      EnableKeyRotation: true
      KeyPolicy:
        Version: '2012-10-17'
        Statement:
          - Sid: EnableRootAccountAdmin
            Effect: Allow
            Principal:
              AWS: !Sub 'arn:aws:iam::${AWS::AccountId}:root'
            Action: 'kms:*'
            Resource: '*'
      Tags:
        - {Key: Project, Value: clickhouse-private}

  # Retained alongside the key: this is the recovery handle. See
  # tasks/main.yml for the full recovery procedure after a stack recreation.
  LangfuseBucketKmsAlias:
    Type: AWS::KMS::Alias
    DeletionPolicy: Retain
    UpdateReplacePolicy: Retain
    Properties:
      AliasName: "alias/{{ infrastructure.environment_name }}-langfuse-bucket"
      TargetKeyId: !Ref LangfuseBucketKmsKey
{% endif %}

Outputs:
  LangfuseS3RoleArn:
    Description: The Langfuse chart's ServiceAccount is annotated with this in Step 15.
    Value: !GetAtt LangfuseS3Role.Arn
{% if fips %}
  LangfuseBucketKmsKeyArn:
    Description: >-
      Passed as the Langfuse bucket's encryption_key_id in
      langfuse_storage/tasks/main.yml. Retained on teardown -- see the key's
      own comment above for the recovery path if this stack is recreated.
    Value: !GetAtt LangfuseBucketKmsKey.Arn
{% endif %}

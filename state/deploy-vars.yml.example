# Tracked example of the local override for ansible/group_vars/all.yml. See
# docs/part-1-prerequisites.md section 3b -- the real file,
# state/deploy-vars.yml, is generated automatically (gitignored) the first
# time you run any script under scripts/, with this exact shape.
# Only the keys you set here change; every other default keeps its all.yml
# value (dictionaries merge key by key).
aws:
  # sso     -- the kit renders a project-local .aws/config and you log in with
  #            `aws sso login`.
  # profile -- use a named profile you already have (target_profile, plus
  #            source_ecr_profile for the ECR pull); nothing is rendered.
  auth_mode: "sso"
  # Fill in your account ID and the source registry account ID ClickHouse gave you.
  target_account_id: "<YOUR_ACCOUNT_ID>"
  target_region: "us-east-1"
  target_profile: "ch-gov-target"
  source_ecr_account_id: "<SOURCE_ECR_ACCOUNT_ID>"
  source_ecr_region: "us-east-1"
  source_ecr_profile: "ch-gov-ecr-pull"
  # The role in your account that source_ecr_profile assumes. It is arranged
  # with ClickHouse; the playbook only checks that it can be assumed.
  ecr_pull_role_name: "ClickHouseAirgapECRPullRole"
  ecr_pull_session_name: "ch-gov-ecr-pull"
  # auth_mode: sso only -- ignored in profile mode. Your IAM Identity Center
  # portal start URL; `aws sso login` fails clearly until it is real.
  sso_start_url: "https://<YOUR_SSO_PORTAL_ID>.awsapps.com/start"
  sso_session_name: "ch-gov"
  sso_region: "{{ aws.target_region }}"
  sso_role_name: "AdministratorAccess"

# Optional -- only needed when grafana.enabled is true. A Docker Hub account
# entitled to the DHI (Docker Hardened Images) catalog, used to mirror the
# grafana/awscli images from dhi.io. Leave both empty to fall back to the
# DHI_USERNAME/DHI_TOKEN environment variables; the image_sync role fails
# clearly if grafana.enabled is true and neither is set.
dhi:
  username: ""   # your Docker Hub username
  token: ""      # your Docker Hub DHI access token

# Optional switches. Uncomment only the ones you want; every other key keeps
# its all.yml value. Defaults shown match ansible/group_vars/all.yml.
#
# Deployment size: minimal (the default) or tutorial (the upstream tutorial's
# larger node and pod sizes). See ansible/group_vars/all.yml for both profiles.
# size: tutorial
#
# FIPS build (x86_64, FIPS image tags and endpoints). See
# docs/part-7-fips-hardening.md.
# fips: false
#
# Langfuse (optional Steps 13-15). See docs/part-6-langfuse.md.
# langfuse:
#   enabled: false
#   load_balancer:
#     type: "internal"   # none | internal | public
#     tls: false
#
# Grafana (optional Steps 16-18). Needs the dhi: credentials above. See
# docs/part-8-grafana.md.
# grafana:
#   enabled: false
#   load_balancer:
#     type: "internal"   # none | internal | public
#     tls: false
#
# Single sign-on (optional Steps 6b and 11b): an Amazon Cognito user pool for
# Langfuse sign-in and ClickHouse token (JWT) sign-in. Ansible merges nested
# mappings key by key here (hash_behaviour in ansible.cfg) but replaces a list
# (groups, enforce_domains, networks) as a whole; a run that does not use that
# ansible.cfg replaces the entire sso mapping instead. So copy the complete
# block below rather than a fragment, and set every value you use. Service
# connections keep password authentication. The Cognito client secret is
# generated into state/ and never belongs in this file. See
# ansible/group_vars/all.yml.
# sso:
#   enabled: false
#   provider: "cognito"
#   cognito:
#     domain_prefix: "<YOUR_COGNITO_DOMAIN_PREFIX>"   # unique in the region; no "aws", "amazon" or "cognito"
#     saml_metadata_url: ""   # optional: "<YOUR_IDP_SAML_METADATA_URL>" federates to your identity provider
#     groups:
#       - "clickhouse-readonly"
#       - "clickhouse-admin"
#   langfuse:
#     enabled: false
#     # While this is on, Langfuse sign-up is open whatever langfuse.signup_disabled says
#     # (Langfuse creates a first-time Cognito user through the sign-up path), so with
#     # disable_password_login false anyone who can reach Langfuse can also register with
#     # an email and password. To limit that: true here, enforce_domains, and
#     # langfuse.load_balancer.allowed_cidrs.
#     disable_password_login: false
#     enforce_domains: []   # for example ["<YOUR_EMAIL_DOMAIN>"]
#     default_org_role: "VIEWER"
#     default_project_role: "VIEWER"
#   clickhouse_jwt:
#     enabled: false
#     permission_limit_role: ""
#     group_prefix: "clickhouse-"
#     role_grants: {}   # group -> GRANT statements, written without a TO clause, for example:
#     #  role_grants:
#     #    clickhouse-readonly:
#     #      - "GRANT SELECT ON *.*"
#     # Empty means the VPC CIDR and 127.0.0.1/32. The second entry is the address the server
#     # sees for a kubectl port-forward (the default scripts/ch-client.sh --sso path); 127.0.0.1
#     # is reachable only inside the pod's network namespace and through kubectl port-forward,
#     # so it adds no access for anyone without cluster access. A list you set is used exactly
#     # as given, so include "127.0.0.1/32" in it to keep the port-forward path.
#     networks: []
